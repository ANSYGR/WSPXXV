doctype html
html
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    title= @title || 'App'
    style
      | body { font-family: Arial, sans-serif; margin: 1rem; }
      | nav a { margin-right: 1rem }
  body
    nav
      h1 The Site
      a href='/' Home
      a href='/marketplace' Marketplace
      a href='/forum' Forum
      a href='/shop' Shop
      - if logged_in?
        a href='/account' Konto
        a href='/marketplace/messages' Meddelanden
        span | Inloggad som #{current_user['name']}
        a href='/logout' Logga ut
      - else
        a href='/login' Logga in
    hr
    == yield
    hr
    footer
    p 2024 Webbserverprogrammering, Andy Granfors
    p Tack för att du besöker min webbplats!
